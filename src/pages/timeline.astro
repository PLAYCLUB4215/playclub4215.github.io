---
import BaseLayout from '../layouts/BaseLayout.astro';
import { timeline, type TimelineEntry } from '../data/timeline';

const PALETTE = ['#b98cc4', '#e6b84a', '#5fb0d4', '#d96e7a', '#6cc0a6', '#8a8fd0'];
const CAT_LABELS: Record<string, string> = { life: '生活', work: '工作', travel: '旅遊', project: '專案' };

// 由近到遠排序
const sorted = [...timeline].sort((a, b) => (a.date < b.date ? 1 : a.date > b.date ? -1 : 0));

// 依年份分組（新年份在前）
const years: { year: string; items: TimelineEntry[] }[] = [];
for (const e of sorted) {
  const y = e.date.slice(0, 4);
  let g = years.find((x) => x.year === y);
  if (!g) { g = { year: y, items: [] }; years.push(g); }
  g.items.push(e);
}

let gi = 0; // 全域索引，用來輪播節點顏色
---
<BaseLayout title="時間線 | MIN ZANG" description="一段往下蜿蜒的旅程：每天做了什麼。">
  <h1>時間線</h1>
  <p class="muted">像一條往下走的路，記錄每天的足跡。新的在上，較早的年份可點開。</p>

  {sorted.length === 0 ? (
    <p class="muted">還沒有紀錄。</p>
  ) : (
    years.map((g, yi) => {
      const list = (
        <ol class="journey">
          {g.items.map((e, i) => (
            <li class={`journey-item ${i % 2 === 0 ? 'left' : 'right'}`} style={`--c:${PALETTE[gi++ % PALETTE.length]}`}>
              <div class="journey-node">{e.icon ?? String(i + 1).padStart(2, '0')}</div>
              <div class="journey-card">
                <div class="journey-date">
                  {e.date}
                  {e.category && <span class="journey-cat">{CAT_LABELS[e.category] ?? e.category}</span>}
                </div>
                <div class="journey-title">{e.link ? <a href={e.link}>{e.summary}</a> : e.summary}</div>
              </div>
            </li>
          ))}
        </ol>
      );

      return yi === 0 ? (
        <section class="journey-year">
          <h2 class="journey-year-label">{g.year}</h2>
          {list}
        </section>
      ) : (
        <details class="journey-year">
          <summary class="journey-year-label">
            {g.year}<span class="journey-year-count">{g.items.length} 筆</span>
          </summary>
          {list}
        </details>
      );
    })
  )}
</BaseLayout>
