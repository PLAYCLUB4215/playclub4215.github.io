---
import Nav from '../components/Nav.astro';
import MusicPlayer from '../components/MusicPlayer.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}
const { title, description = '生活、旅遊與 AI 專案的個人紀錄。' } = Astro.props;
---
<!doctype html>
<html lang="zh-Hant">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <script is:inline>document.documentElement.classList.add('anim');</script>
  </head>
  <body>
    <header class="site-header">
      <div class="container"><Nav /></div>
    </header>
    <main class="container">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="container">© {new Date().getFullYear()} MIN ZANG</div>
    </footer>
    <MusicPlayer />
    <div id="cat-runner" aria-hidden="true"></div>
    <script is:inline>
      // 捲動進場動畫：元素進入畫面時淡入上移（尊重 prefers-reduced-motion 由 CSS 控制）
      (function () {
        var els = document.querySelectorAll('.post-card, .timeline-item, .album-grid figure, .video-embed');
        if (!els.length) return;
        if (!('IntersectionObserver' in window)) {
          els.forEach(function (el) { el.classList.add('in'); });
          return;
        }
        var io = new IntersectionObserver(function (entries) {
          entries.forEach(function (en) {
            if (en.isIntersecting) { en.target.classList.add('in'); io.unobserve(en.target); }
          });
        }, { threshold: 0.08 });
        els.forEach(function (el) { io.observe(el); });
      })();

      // 小貓：沿著底部來回跑、轉向、偶爾跳一下
      (function () {
        var cat = document.getElementById('cat-runner');
        if (!cat) return;
        var SCALE = 2, W = 32;
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
          cat.style.backgroundPosition = '-96px -96px';
          cat.style.transform = 'translateX(20px) scaleX(2) scaleY(2)';
          return;
        }
        var frames = ['-96px 0px', '-96px -32px'];
        var x = 20, dir = 1, frame = 0, lastT = 0, lastFrame = 0, jumpStart = -1, nextJump = null;
        var JUMP_DUR = 460, JUMP_H = 18, SPEED = 0.06;
        function maxX() { return Math.max(40, window.innerWidth - W * SCALE - 8); }
        function loop(ts) {
          if (!lastT) lastT = ts;
          if (nextJump === null) nextJump = ts + 1500;
          var dt = Math.min(50, ts - lastT); lastT = ts;
          x += dir * SPEED * dt;
          if (x <= 8) { x = 8; dir = 1; }
          else if (x >= maxX()) { x = maxX(); dir = -1; }
          if (ts - lastFrame > 130) { frame ^= 1; cat.style.backgroundPosition = frames[frame]; lastFrame = ts; }
          var jy = 0;
          if (jumpStart < 0 && ts > nextJump) jumpStart = ts;
          if (jumpStart >= 0) {
            var p = (ts - jumpStart) / JUMP_DUR;
            if (p >= 1) { jumpStart = -1; nextJump = ts + 1500; }
            else jy = Math.sin(Math.PI * p) * JUMP_H;
          }
          var face = (dir === 1) ? -1 : 1;
          cat.style.transform = 'translateX(' + x.toFixed(1) + 'px) translateY(' + (-jy).toFixed(1) + 'px) scaleX(' + (SCALE * face) + ') scaleY(' + SCALE + ')';
          requestAnimationFrame(loop);
        }
        requestAnimationFrame(loop);
      })();
    </script>
  </body>
</html>
