---
import { playlist } from '../data/music';
const hasMusic = playlist.length > 0;
const firstTitle = hasMusic ? playlist[0].title : '尚未加入音樂';
---
<div id="music-player" class="music-player" transition:persist="music">
  <button id="music-toggle" class="music-btn" aria-label="播放 / 暫停" disabled={!hasMusic}>
    <span class="music-icon-play">▶</span>
    <span class="music-icon-pause">❚❚</span>
  </button>
  <span id="music-title" class="music-title">{firstTitle}</span>
  {playlist.length > 1 && (
    <button id="music-next" class="music-btn music-next" aria-label="下一首">⏭</button>
  )}
  {hasMusic && (
    <input id="music-volume" class="music-volume" type="range" min="0" max="1" step="0.05" value="0.3" aria-label="音量" />
  )}
  <audio id="music-audio" preload="none"></audio>
</div>

<script>
  import { playlist } from '../data/music';

  const audio = document.getElementById('music-audio') as HTMLAudioElement | null;
  const toggle = document.getElementById('music-toggle');
  const nextBtn = document.getElementById('music-next');
  const titleEl = document.getElementById('music-title');
  const player = document.getElementById('music-player');
  const volume = document.getElementById('music-volume') as HTMLInputElement | null;

  if (audio && toggle && player && playlist.length > 0) {
    let idx = 0;
    const load = (i: number) => {
      idx = (i + playlist.length) % playlist.length;
      audio.src = playlist[idx].src;
      if (titleEl) titleEl.textContent = playlist[idx].title;
    };

    const savedVol = parseFloat(localStorage.getItem('music-vol') ?? '0.3');
    audio.volume = isNaN(savedVol) ? 0.3 : savedVol;
    if (volume) volume.value = String(audio.volume);

    load(0);

    toggle.addEventListener('click', () => {
      if (audio.paused) audio.play();
      else { audio.pause(); localStorage.setItem('music-on', '0'); }
    });
    audio.addEventListener('play', () => { player.classList.add('playing'); localStorage.setItem('music-on', '1'); });
    audio.addEventListener('pause', () => player.classList.remove('playing'));
    audio.addEventListener('ended', () => { load(idx + 1); audio.play(); });
    nextBtn?.addEventListener('click', () => {
      const wasPlaying = !audio.paused;
      load(idx + 1);
      if (wasPlaying) audio.play();
    });
    volume?.addEventListener('input', () => {
      audio.volume = parseFloat(volume.value);
      localStorage.setItem('music-vol', volume.value);
    });

    // 第一次與頁面互動（點任意處）就自動開始播放，除非使用者曾手動暫停
    const wantsMusic = () => localStorage.getItem('music-on') !== '0';
    if (wantsMusic()) {
      const evs = ['pointerdown', 'touchstart', 'keydown'];
      const startOnce = () => {
        evs.forEach((ev) => document.removeEventListener(ev, startOnce));
        if (audio.paused && wantsMusic()) audio.play().catch(() => {});
      };
      evs.forEach((ev) => document.addEventListener(ev, startOnce, { passive: true }));
    }
  }
</script>
